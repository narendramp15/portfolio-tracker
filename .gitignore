.env
.env.local
.env.*.local
.venv/
venv/
env/
ENV/
.uv/
.python-version

# ── Frontend (React/Vite) ─────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*

# ── IDEs & OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Local data & artifacts ────────────────────────────────────────────────
*.db
*.sqlite3
*.log
logs/
# Compressed server logs. Access logs record client IPs and full request
# lines, and OAuth callbacks here carry ?code= / ?request_token= in the URL,
# so a stray `git add -A` would publish live credentials.
*.log.gz
*_log-*.gz
*ssl_log*
access_log*
error_log*
data/
# Exception: static reference data the app reads at runtime (published
# exchange figures, not a local dump). Code depends on this path existing,
# so it has to ship with the repo.
!portfolio_tracker/data/
!portfolio_tracker/data/**
temp/
graphify-out/

# ── Local-only docs & samples (kept out of the public repo) ──────────────
