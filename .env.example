# ──────────────────────────────────────────────────────────────────────────────
# Portfolio Tracker — Environment Configuration
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
DEBUG=True
LOG_LEVEL=INFO

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be persistent across deploys — broker credentials are encrypted with this key.
ENCRYPTION_KEY=your-fernet-encryption-key-here

# ── Database (choose ONE option) ────────────────────────────────────────────
# Option 1: Individual PostgreSQL variables (Neon / Supabase style — RECOMMENDED)
PGUSER=postgres
PGPASSWORD=your_database_password_here
PGHOST=aws-0-us-east-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
# PGSSLMODE=require

# Option 2: Full connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 3: MariaDB / MySQL
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname?charset=utf8mb4

# Option 4: SQLite (local dev only — NOT for production)
# DATABASE_URL=sqlite:///./portfolio.db

# ── Google OAuth (get from https://console.cloud.google.com/apis/credentials) ─
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Production: https://your-domain.com/api/auth/google/callback

# ── Frontend / CORS (REQUIRED in production) ────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Production: https://quantleap.in
# Comma-separated origins. Wildcard "*" is blocked when credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Production: https://quantleap.in,https://www.quantleap.in

# ── SMTP Email (for password-reset emails; falls back to console log if unset) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@quantleap.in

# ── Broker APIs ──────────────────────────────────────────────────────────────
# Zerodha KiteConnect (https://kite.trade)
# Per-user credentials are stored encrypted in the DB; these are optional global defaults.
ZERODHA_REDIRECT_URL=http://localhost:8000/api/broker/zerodha/callback

# 5Paisa
5PAISA_API_KEY=your_5paisa_api_key
5PAISA_API_SECRET=your_5paisa_api_secret

# ── Razorpay Billing ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PLAN_ID_PRO=your_razorpay_plan_id_pro
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_STARTER_PAYMENT_LINK=https://rzp.io/rzp/your-link
RAZORPAY_STARTER_LINK_ID=plink_XXXXXXXXXXXXXXXX

# ── AI / Anthropic (for Nifty Options Analyzer proxy) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
MODEL_STARTER=claude-haiku-4-5-20251001
MODEL_PRO=claude-sonnet-4-6
MODEL_ELITE=claude-sonnet-4-6
ZERODHA_REDIRECT_URL=http://localhost:8000/app/brokers
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ifvqywnpnnnwesbabiex.supabase.co:5432/postgres
DATABASE_PWD=[YOUR-PASSWORD]

# Razorpay Billing (required for paid subscriptions)
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Create a ₹199/month recurring plan in Razorpay dashboard and paste the plan_id here
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxx

# Options Analyzer AI (Anthropic — required for /app/options-analyzer)
# Get API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxx
# Model routing — server-side only; these names are NEVER sent to the client
MODEL_STARTER=claude-haiku-4-5-20251001
MODEL_PRO=claude-sonnet-4-6
MODEL_ELITE=claude-sonnet-4-6
# Set a webhook secret in Razorpay dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
