# Environment Configuration
DEBUG=True
LOG_LEVEL=INFO

# API Configuration
API_KEY=your_api_key_here
API_ENDPOINT=https://api.example.com

# Security
SECRET_KEY=your-secret-key-change-this-in-production-12345678
ENCRYPTION_KEY=your-encryption-key-here

# Google OAuth (Get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# For production: https://portfolio-tracker-ikoj.onrender.com/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173
# For production: https://quantleap.in

# Database Configuration
# Choose ONE of the following approaches:

# Option 1: Individual PostgreSQL variables (Neon/Supabase style - RECOMMENDED)
# The app will auto-construct the connection string from these
PGUSER=postgres
PGPASSWORD=your_database_password_here
PGHOST=aws-0-us-east-1.pooler.supabase.com
PGPORT=6543
PGDATABASE=postgres

# Option 2: Full connection string (alternative)
# DATABASE_URL=postgresql://postgres:password@host:5432/database

# Option 3: SQLite (local development only - NOT for production)
# DATABASE_URL=sqlite:///./portfolio.db

SECRET_KEY=your-secret-key-here

# Encryption Configuration
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# Zerodha KiteConnect Configuration
# Get your API key and secret from https://kite.trade
# Note: These are stored in the database (encrypted) per user, not as environment variables
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_REDIRECT_URL=http://localhost:8000/app/brokers
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ifvqywnpnnnwesbabiex.supabase.co:5432/postgres
DATABASE_PWD=[YOUR-PASSWORD]

# Razorpay Billing (required for paid subscriptions)
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Create a ₹199/month recurring plan in Razorpay dashboard and paste the plan_id here
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxx

# Options Analyzer AI (Anthropic — required for /app/options-analyzer)
# Get API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxx
# Model routing — server-side only; these names are NEVER sent to the client
MODEL_STARTER=claude-haiku-4-5-20251001
MODEL_PRO=claude-sonnet-4-6
MODEL_ELITE=claude-sonnet-4-6
# Set a webhook secret in Razorpay dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
