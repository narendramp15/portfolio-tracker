# .env  –  cPanel deployment environment variables
# -------------------------------------------------------
# Copy this file to .env and fill in your actual values.
# Place .env in the same directory as passenger_wsgi.py
# (your application root on cPanel).
# -------------------------------------------------------

# ── Database ────────────────────────────────────────────
# Option A: SQLite (simplest — no extra setup needed on cPanel)
DATABASE_URL=sqlite:///./portfolio.db

# Option B: MySQL / MariaDB (common on shared cPanel hosts)
# DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@localhost/<db_name>

# Option C: PostgreSQL (if your host provides it)
# PGUSER=your_pg_user
# PGPASSWORD=your_pg_password
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=your_db_name

# ── Security ─────────────────────────────────────────────
# Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# Key for encrypting broker credentials at rest.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# ── App URLs ─────────────────────────────────────────────
# The public URL of your cPanel site (no trailing slash)
FRONTEND_URL=https://yourdomain.com

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://yourdomain.com

# ── Google OAuth (optional) ──────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# ── JWT ──────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=43200   # 30 days

# ── Debug (set to false in production) ───────────────────
DEBUG=false
